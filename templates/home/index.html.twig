{% extends 'base.html.twig' %}

{% block title %}Stubborn - Accueil{% endblock %}

{% block home %}

    <!-- Produits mis en avant -->
    <div class="row gap-4 margin-top-10 margin-bottom-10">
        {% for product in products %}
            <div class="col-md background-white border-dark">
                <div class="container">
                    <div class="d-flex justify-content-center margin-top-10 margin-bottom-10">
                        <img src="{{ asset('img/Product/' ~ product.image) }}" alt="{{ product.name }}" class="img-fluid">
                    </div>
                    <div class="row justify-content-between align-items-center">
                        <p class="col">
                            <strong>{{ product.name }}</strong></br>
                            {{ product.price }}€
                        </p>

                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <a href="{{ path('app_product', { id: product.id }) }}" class="col btn btn-primary">Voir</a>
                        {% else %}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun produit trouvé.</p>
        {% endfor %}
    </div>
{% endblock %}
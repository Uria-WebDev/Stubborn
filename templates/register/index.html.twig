                <input></input>
            </div>

            <div class="margin-top-20">
                <label>Confirmer le mot de passe :</label></br>
                <input></input>
            </div>

            <div class="margin-top-20 padding-bottom-20 border-bottom-blue text-center">
                <a href="#" class="btn btn-primary">Créer un compte</a></br>
            </div>

            <div class="margin-top-20">
                <p class="margin-bottom-0">Déjà inscrit ?</p></br>
                <div class="text-center">
                    <a href="{{ path('app_login') }}" class="btn btn-primary">Se Connecter</a>
                </div>
            </div>

        </form>
        <div class="col-4"></div>
    </div>
{% endblock %}
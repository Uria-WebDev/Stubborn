{% extends 'base.html.twig' %}

{% block title %}Stubborn - S'inscrire{% endblock %}

{% block login %}

    <!-- Formulaire d'inscription -->
    <div class="row">
        <div class="col-4"></div>
        <form class="col-4 border-dark margin-top-10 margin-bottom-10 padding-top-20 padding-bottom-20 background-white">

            <p class="padding-bottom-20 border-bottom-blue">S'inscrire</p>

            <div class="margin-top-20">
                <label>Nom d'utilisateur :</label></br>
                <input></input>
            <div>

            <div class="margin-top-20">
                <label>Adresse mail :</label></br>
                <input></input>
            </div>

            <div class="margin-top-20">
                <label>Adresse de livraison :</label></br>
                <input></input>
            </div>

            <div class="margin-top-50">

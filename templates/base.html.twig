<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>{% block title %}Stubborn{% endblock %}</title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
  </head>
  <body>
    {% block body %}
      <!-- HEADER -->
      <header class="border-bottom-dark background-white sticky">
          <div class="container">
              <div class="row justify-content-between align-items-center">
                  <div class="col-md-7">
                      <!-- Logo -->
                      <a href="/">
                          <img src="{{ asset('img/Logo.png') }}" alt="Logo de Stubborn" width="100"></img>
                      </a>
                      <!-- Slogan -->
                      <p><small>Don't compromise on your look</small></p>
                  </div>

                  <!-- Barre de navigation -->
                  <div class="col-md-5">
                      <nav class="row text-center">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}

                            <!-- Utilisateur connecté -->
                            <a href="{{ path('app_home') }}" class="col-md decoration-none decoration-hov">Accueil</a>
                            <a href="{{ path('app_shop') }}" class="col-md decoration-none decoration-hov">Boutique</a>
                            <a href="{{ path('app_cart') }}" class="col-md decoration-none decoration-hov">Panier</a>
                            <a href="{{ path('app_logout') }}" class="col-md">Se déconnecter</a>
                        {% else %}
                        
                            <!-- Utilisateur déconnecté -->
                            <a href="{{ path('app_home') }}" class="col-md decoration-none decoration-hov">Accueil</a>
                            <a href="{{ path('app_register') }}" class="col-md decoration-none decoration-hov">S’inscrire</a>
                            <a href="{{ path('app_login') }}" class="col-md decoration-none decoration-hov">Se connecter</a>
                        {% endif %}
                      </nav>
                  </div>
              </div>
          </div>
      </header>

      <main class="container margin-top-20">
        {% block home %}{% endblock %}
        {% block shop %}{% endblock %}
        {% block login %}{% endblock %}
      </main>

      <!-- FOOTER -->
      <footer class="border-top-dark margin-top-20 background-white">
          <div class="container margin-top-20 padding-bottom-20">
              <small>Stubborn</small></br>
              <small><a target="_blank" href="https://www.google.com/maps/place/Piccadilly+Circus,+London,+Royaume-Uni/@51.509863,-0.1368558,17z/data=!3m1!4b1!4m6!3m5!1s0x487604d3ff201fc1:0xf08adf0cfb3eb2fe!8m2!3d51.5098597!4d-0.1342809!16zL20vMDFoYzZx?entry=ttu&g_ep=EgoyMDI1MTExMi4wIKXMDSoASAFQAw%3D%3D">
                  Piccadilly Circus, London W1J 0DA, Royaume-Uni
              </a></small></br>
              <small><a href="mailto:stubborn@blabla.com">stubborn@blabla.com</a></small>
          </div>
      </footer>
    {% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  </body>
</html>
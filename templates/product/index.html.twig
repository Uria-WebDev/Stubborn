{% extends 'base.html.twig' %}

{% block title %}Stubborn - {{ product.name }}{% endblock %}

{% block shop %}
<div class="row gap-4">

    <div class="col-md-5">
        <a href="{{ asset('img/Product/' ~ product.image) }}">
            <img src="{{ asset('img/Product/' ~ product.image) }}" alt="{{ product.name }}" class="img-fluid border-dark width-100">
        </a>
    </div>

    <div class="col-md-5">
        <div class="row gap-4 justify-content-between">
    
            <div class="col-md-5">
                <p><strong>Nom</strong><br>
                {{ product.name }}
                </p>

                <p><strong>Prix</strong><br>
                {{ product.price }} €
                </p>
            </div>

            <div class="col-md-5">
                <p><strong>Tailles</strong></p>

                <ul class="list-group">
                    {% for size in product.sizes %}
                        <a href="#" class="list-group-item size-item" data-size="{{ size.label }}">
                            {{ size.label }}
                        </a>
                    {% endfor %}
                </ul>

                <script>
                document.querySelectorAll('.size-item').forEach(el => {
                    el.addEventListener('click', () => {
                        document.getElementById('selected-size').value = el.dataset.size;
                        document.querySelectorAll('.size-item').forEach(li => li.classList.remove('active'));
                        el.classList.add('active');
                    });
                });
                </script>
            </div>
        </div>

        <form action="{{ path('cart_add') }}" method="POST">
            <input type="hidden" name="product_id" value="{{ product.id }}">
            <input type="hidden" name="size" id="selected-size">

            <button type="submit" class="btn btn-primary mt-3 width-100">Ajouter au panier</button>
        </form>
    </div>

</div>
{% endblock %}